// STOP - schema Prisma / MySQL
// Referencia: specifications.md secoes 28 e 29.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Estados do jogador dentro da sala/rodada (spec 7)
enum PlayerStatus {
  WAITING
  READY
  PLAYING
  SUBMITTED
  ELIMINATED
  FINISHED
}

/// Maquina de estados da rodada (spec 32).
/// COLLABORATIVE_CORRECTION fica entre STOPPED e CORRECTION: correcao dos
/// colegas primeiro, depois a correcao oficial do professor (CORRECTION,
/// inalterada) — ver enhancements.md secao 35.
enum RoundStatus {
  CREATED
  READY
  STARTING
  PLAYING
  STOPPED
  COLLABORATIVE_CORRECTION
  CORRECTION
  SCORED
  FINISHED
}

/// Decisao de um aluno ao corrigir a resposta de um colega (enhancements.md
/// secao 15). PENDING e o estado inicial: a atribuicao ja existe (para
/// progresso "5/8" e para impedir auto-correcao/duplicidade), mas o aluno
/// ainda nao decidiu.
/// Regra lexical usada para avaliar se uma resposta "bate" com a letra
/// sorteada (spec 21) — escolhida pelo professor ao criar a rodada.
enum LetterRule {
  STARTS_WITH
  CONTAINS
}

enum ReviewDecision {
  PENDING
  VALID
  INVALID
}

enum GameStatus {
  CREATED
  ACTIVE
  FINISHED
}

enum RoomStatus {
  OPEN
  LOCKED
  CLOSED
}

/// Resultado da correcao manual do professor (spec 18)
enum ReviewState {
  PENDING
  VALID
  INVALID
  BLANK
  DUPLICATE
}

/// Colocacao no podio ao finalizar uma partida — so o top 3 (empates
/// contam pela posicao, nao pelo indice na lista).
enum Medal {
  GOLD
  SILVER
  BRONZE
}

/// Professor / administrador (spec 35)
model Teacher {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("TEACHER")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  games Game[]
}

model Class {
  id         Int      @id @default(autoincrement())
  name       String
  code       String   @unique
  /// Disciplina que esta turma oferece (ex.: "React Native") — usada para
  /// filtrar relatorios entre partidas/turmas diferentes da mesma materia.
  /// Nula ate o professor preencher; turmas antigas nao sao migradas
  /// automaticamente.
  discipline String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  enrollments Enrollment[]
  games       Game[]
}

model Student {
  id                 Int      @id @default(autoincrement())
  registrationNumber String   @unique
  name               String
  /// Foto (data URL) ou caminho de um avatar pre-pronto (/avatars/*.svg).
  /// Escolhido pelo proprio aluno ao entrar na sala.
  avatarUrl          String?  @db.Text
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  enrollments Enrollment[]
  sessions    PlayerSession[]
  scores      Score[]
  gameResults GameResult[]

  @@index([registrationNumber])
}

/// Um aluno pode cursar mais de uma turma ao mesmo tempo (ex.: import do
/// QrGrades, onde "disciplina" vira turma e um aluno cursa varias).
model Enrollment {
  id        Int      @id @default(autoincrement())
  studentId Int
  classId   Int
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([studentId])
  @@index([classId])
}

model Game {
  id         Int        @id @default(autoincrement())
  name       String
  classId    Int
  teacherId  Int
  status     GameStatus @default(CREATED)
  createdAt  DateTime   @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  // Restrict (nao Cascade): apagar uma turma nao pode levar junto o
  // historico de partidas ja jogadas nela (spec 44). O endpoint de remocao
  // de turma deve falhar com 409 enquanto houver partidas vinculadas.
  class   Class   @relation(fields: [classId], references: [id], onDelete: Restrict)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  rooms   Room[]
  rounds  Round[]
  scores  Score[]
  results GameResult[]

  @@index([classId])
  @@index([teacherId])
}

model Room {
  id        Int        @id @default(autoincrement())
  gameId    Int
  code      String     @unique
  status    RoomStatus @default(OPEN)
  createdAt DateTime   @default(now())

  game     Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  sessions PlayerSession[]

  @@index([gameId])
}

model PlayerSession {
  id             Int          @id @default(autoincrement())
  roomId         Int
  studentId      Int
  token          String       @unique
  status         PlayerStatus @default(WAITING)
  socketId       String?
  connectedAt    DateTime?
  disconnectedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  // Restrict: apagar um aluno nao pode levar junto o historico de partidas
  // em que ele ja participou (spec 44). O endpoint de remocao de aluno deve
  // falhar com 409 enquanto houver sessoes vinculadas.
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  answers      Answer[]
  participants RoundParticipant[]
  stoppedRounds Round[] @relation("FirstStopper")
  answerReviewsGiven AnswerReview[]

  @@unique([roomId, studentId])
  @@index([roomId])
  @@index([studentId])
}

model CategorySet {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories Category[]
  rounds     Round[]
}

model Category {
  id            Int      @id @default(autoincrement())
  categorySetId Int
  name          String
  description   String?  @db.Text
  required      Boolean  @default(true)
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categorySet     CategorySet     @relation(fields: [categorySetId], references: [id], onDelete: Cascade)
  roundCategories RoundCategory[]

  @@index([categorySetId])
}

model Round {
  id              Int         @id @default(autoincrement())
  gameId          Int
  roundNumber     Int
  categorySetId   Int?
  themeName       String
  letter          String      @db.VarChar(4)
  letterRule      LetterRule  @default(STARTS_WITH)
  durationSeconds Int         @default(120)
  status          RoundStatus @default(CREATED)
  startedAt       DateTime?
  /// Momento (absoluto, servidor) em que a letra deixa de ficar oculta do
  /// aluno e o cronometro de fato comeca — preenchido apos a animacao
  /// publica e a contagem regressiva sincronizada (enhancements.md secoes
  /// 4-7 e 54). Nulo enquanto a rodada nao chegou a esse ponto.
  revealAt        DateTime?
  endsAt          DateTime?
  /// Prazo da fase de correcao colaborativa (enhancements.md secao 40);
  /// usado para recalcular o timer se o servidor reiniciar no meio da fase
  /// (mesmo padrao de `endsAt`/`recoverActiveRounds`).
  collaborativeCorrectionEndsAt DateTime?
  stoppedAt       DateTime?
  scoredAt        DateTime?
  stopReason      String?
  firstStopperId  Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  game         Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  categorySet  CategorySet?   @relation(fields: [categorySetId], references: [id], onDelete: SetNull)
  firstStopper PlayerSession? @relation("FirstStopper", fields: [firstStopperId], references: [id], onDelete: SetNull)

  categories    RoundCategory[]
  answers       Answer[]
  participants  RoundParticipant[]
  answerReviews AnswerReview[]

  @@unique([gameId, roundNumber])
  @@index([gameId])
}

/// Copia imutavel das categorias no momento da criacao da rodada (spec 17)
model RoundCategory {
  id          Int     @id @default(autoincrement())
  roundId     Int
  categoryId  Int?
  name        String
  description String? @db.Text
  required    Boolean @default(true)
  order       Int     @default(0)

  round    Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  answers Answer[]

  @@unique([roundId, order])
  @@index([roundId])
}

/// Estado do jogador em uma rodada especifica. Eliminacoes valem apenas
/// para a rodada corrente (spec 26 e 27).
model RoundParticipant {
  id              Int          @id @default(autoincrement())
  roundId         Int
  playerSessionId Int
  status          PlayerStatus @default(PLAYING)
  eliminatedAt    DateTime?
  eliminationReason String?
  submittedAt     DateTime?
  roundScore      Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  round         Round         @relation(fields: [roundId], references: [id], onDelete: Cascade)
  playerSession PlayerSession @relation(fields: [playerSessionId], references: [id], onDelete: Cascade)

  @@unique([roundId, playerSessionId])
  @@index([roundId])
  @@index([playerSessionId])
}

model Answer {
  id              Int         @id @default(autoincrement())
  roundId         Int
  playerSessionId Int
  roundCategoryId Int
  value           String      @db.VarChar(255)
  normalizedValue String      @db.VarChar(255)
  reviewState     ReviewState @default(PENDING)
  isValid         Boolean?
  score           Int         @default(0)
  submittedAt     DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  round         Round         @relation(fields: [roundId], references: [id], onDelete: Cascade)
  playerSession PlayerSession @relation(fields: [playerSessionId], references: [id], onDelete: Cascade)
  roundCategory RoundCategory @relation(fields: [roundCategoryId], references: [id], onDelete: Cascade)
  reviews       AnswerReview[]

  @@unique([roundId, playerSessionId, roundCategoryId])
  @@index([roundId])
  @@index([playerSessionId])
  @@index([roundCategoryId])
  @@index([roundId, roundCategoryId])
}

/// Avaliacao de um colega sobre a resposta de outro aluno — correcao
/// colaborativa (enhancements.md secoes 9-16). Nunca o proprio autor da
/// resposta (checado em servico, nao aqui: o schema nao consegue expressar
/// "grader != autor"). Nunca mais de uma avaliacao por par
/// avaliador/resposta (@@unique abaixo, secao 14).
model AnswerReview {
  id                    Int            @id @default(autoincrement())
  roundId               Int
  answerId              Int
  graderPlayerSessionId Int
  decision              ReviewDecision
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  round               Round         @relation(fields: [roundId], references: [id], onDelete: Cascade)
  answer              Answer        @relation(fields: [answerId], references: [id], onDelete: Cascade)
  graderPlayerSession PlayerSession @relation(fields: [graderPlayerSessionId], references: [id], onDelete: Cascade)

  @@unique([answerId, graderPlayerSessionId])
  @@index([roundId])
  @@index([graderPlayerSessionId])
}

model Score {
  id        Int      @id @default(autoincrement())
  gameId    Int
  studentId Int
  total     Int      @default(0)
  updatedAt DateTime @updatedAt

  game    Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([gameId, studentId])
  @@index([gameId])
}

/// Registro permanente de desempenho por aluno numa partida finalizada —
/// diferente de `Score` (total corrente, existe desde o inicio da partida),
/// isto so e criado quando o professor finaliza o jogo e alimenta os
/// relatorios academicos entre partidas/turmas.
model GameResult {
  id        Int      @id @default(autoincrement())
  gameId    Int
  studentId Int
  score     Int
  position  Int
  medal     Medal?
  createdAt DateTime @default(now())

  game    Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  // Restrict: apagar um aluno nao pode levar junto o historico academico
  // que o professor usa para avaliacao (mesmo padrao de PlayerSession).
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([gameId, studentId])
  @@index([studentId])
  @@index([gameId])
}

/// Telemetria (spec 25 e 43). Nao usada como prova de saida da aplicacao.
model TelemetryEvent {
  id              Int      @id @default(autoincrement())
  type            String
  roomId          Int?
  roundId         Int?
  playerSessionId Int?
  payload         Json?
  createdAt       DateTime @default(now())

  @@index([roundId])
  @@index([playerSessionId])
  @@index([type])
}
