# ---------------------------------------------------------------------------
# STOP - variaveis de ambiente (nunca versione credenciais reais, spec 58)
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Banco de dados
# Local:  mysql://stop:stop@localhost:3306/stop
# Docker: mysql://stop:stop@mysql:3306/stop
DATABASE_URL=mysql://stop:stop@localhost:3306/stop
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=stop
MYSQL_USER=stop
MYSQL_PASSWORD=change-me

# Segredo de assinatura das sessoes administrativas
SESSION_SECRET=change-me
ADMIN_TOKEN_TTL=12h

# Credencial administrativa inicial (criada pelo seed)
ADMIN_EMAIL=professor@stop.local
ADMIN_PASSWORD=change-me
ADMIN_NAME=Professor

# Regras do jogo
DEFAULT_ROUND_DURATION=120
LETTER_POOL=ABCDEFGHIJLMNOPRSTUV

# Rede
# Vazio = aceita qualquer origem (util na rede local da sala, spec 37).
CORS_ORIGINS=
# URL usada no QR Code quando o backend nao consegue deduzir o host.
PUBLIC_BASE_URL=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20

# Frontend (Vite). Vazio = mesma origem da pagina.
VITE_API_URL=
VITE_SOCKET_URL=
